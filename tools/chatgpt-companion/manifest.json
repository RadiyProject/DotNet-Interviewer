{
  "manifest_version": 3,
  "name": "Forge · ChatGPT Voice Companion",
  "version": "1.5.0",
  "description": "Pair one local Forge interview with one ChatGPT tab, share context and sync its visible transcript.",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["https://chatgpt.com/*", "http://localhost:8080/*", "http://127.0.0.1:8080/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Forge · ChatGPT Voice"},
  "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["chatgpt.js"], "run_at": "document_idle"}]
}
